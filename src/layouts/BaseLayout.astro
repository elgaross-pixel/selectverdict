---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
// Disabled unless explicitly configured at build time after privacy review and collector deployment.
const analyticsEndpoint = import.meta.env.PUBLIC_SV_ANALYTICS_ENDPOINT || '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#185c47" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script define:vars={{ analyticsEndpoint }} is:inline>
      (() => {
        if (analyticsEndpoint) {
          const params = new URLSearchParams(location.search);
          const allowedSources = new Set(["reddit", "linkedin", "substack", "flipboard", "pinterest"]);
          const source = params.get("utm_source") || "direct";
          const campaign = params.get("utm_campaign") || "";
          const attribution = { source: allowedSources.has(source) ? source : "other", medium: params.get("utm_medium") || "", campaign, content: params.get("utm_content") || "" };
          const send = (event_type, merchant = "") => {
            const payload = JSON.stringify({ ...attribution, event_type, source_page: location.pathname, merchant });
            try { if (!navigator.sendBeacon || !navigator.sendBeacon(analyticsEndpoint, new Blob([payload], { type: "application/json" }))) fetch(analyticsEndpoint, { method: "POST", body: payload, headers: { "Content-Type": "application/json" }, keepalive: true }).catch(() => {}); } catch { /* analytics must not block navigation */ }
          };
          send("page_view");
          window.addEventListener("selectverdict:merchant-click", (event) => send("merchant_click", event.detail?.merchant || ""));
        }
        if (window.__selectVerdictMerchantTracking) return;
        window.__selectVerdictMerchantTracking = true;
        window.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a[data-sv-event="merchant_click"]') : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          const detail = {
            event: 'merchant_click',
            merchant: link.dataset.svMerchant || 'unknown',
            product: link.dataset.svProduct || 'unknown',
            sourcePage: link.dataset.svSourcePage || location.pathname,
            affiliate: link.dataset.svAffiliate === 'true',
            destinationOrigin: new URL(link.href, location.href).origin,
            occurredAt: new Date().toISOString()
          };
          window.dispatchEvent(new CustomEvent('selectverdict:merchant-click', { detail }));
          const handlers = Array.isArray(window.selectVerdictEventHandlers) ? window.selectVerdictEventHandlers : [];
          for (const handler of handlers) {
            try { if (typeof handler === 'function') handler(detail); } catch { /* outbound navigation must not be blocked */ }
          }
        });
      })();
    </script>
  </body>
</html>
