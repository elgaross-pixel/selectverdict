---
const rows = [
  ['Contacts', '2,000', '5,000', '10,000', 'Unlimited'],
  ['Sales funnels', '3', '10', '50', 'Unlimited'],
  ['Funnel steps', '15', '50', '300', 'Unlimited'],
  ['Blogs', '1', '5', '20', 'Unlimited'],
  ['Courses', '1', '5', '20', 'Unlimited'],
  ['Creator stores', '1', '3', '10', 'Unlimited'],
  ['Creator store products', '3', '15', '50', 'Unlimited'],
  ['Automation rules', '1', '10', '100', 'Unlimited'],
  ['Workflows', '1', '5', '20', 'Unlimited'],
  ['Tags', '1', '10', '100', 'Unlimited'],
  ['Email campaigns', '1', '10', '100', 'Unlimited'],
  ['One-click upsells', '1', '10', '100', 'Unlimited'],
  ['Order bumps', '1', '10', '100', 'Unlimited'],
  ['A/B tests', '1', '10', '50', 'Unlimited'],
  ['Coupons', '1', '10', '50', 'Unlimited'],
  ['Custom domains', '1', '3', '10', 'Unlimited'],
  ['Websites', '1', '5', '20', 'Unlimited'],
  ['Languages per website', '2', 'Unlimited', 'Unlimited', 'Unlimited'],
  ['Webinars', '0', '0', '10', 'Unlimited'],
  ['Communities', '1', '5', '20', 'Unlimited'],
  ['Product variants', '50', '100', '250', 'Unlimited'],
  ['Pipelines', '1', '5', '20', 'Unlimited'],
  ['Calendar events', '1', '5', '20', 'Unlimited'],
  ['Students', '500', 'Unlimited', 'Unlimited', 'Unlimited'],
  ['Revenue from sales limit', '$10,000', 'Unlimited', 'Unlimited', 'Unlimited'],
] as const;
---
<div class="table-scroll" tabindex="0" role="region" aria-label="Systeme.io plan limits comparison">
  <table>
    <thead><tr><th scope="col">Feature / limit</th><th scope="col">Free</th><th scope="col">Startup</th><th scope="col">Webinar</th><th scope="col">Unlimited</th></tr></thead>
    <tbody>{rows.map(([feature, ...values]) => <tr><th scope="row">{feature}</th>{values.map((value) => <td>{value}</td>)}</tr>)}</tbody>
  </table>
</div>
<style>
  .table-scroll { overflow-x: auto; max-width: 100%; border: 1px solid var(--line); border-radius: var(--radius); }
  .table-scroll:focus-visible { outline: 3px solid var(--brand-dark); outline-offset: 3px; }
  table { width: 100%; min-width: 42rem; border-collapse: collapse; background: var(--surface); font-size: 0.92rem; }
  th, td { padding: 0.7rem 0.8rem; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
  th:first-child { position: sticky; left: 0; z-index: 1; background: var(--surface); text-align: left; }
  thead th { background: var(--surface-muted); font-weight: 800; }
  thead th:first-child { background: var(--surface-muted); }
  tbody tr:last-child > * { border-bottom: 0; }
</style>
