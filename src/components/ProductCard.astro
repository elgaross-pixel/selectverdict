---
import type { Product } from '../lib/content';
interface Props { product: Product; href?: string }
const { product, href } = Astro.props;
---
<article class="card product-card"><p class="eyebrow">{product.data.categories.join(' · ')}</p><h2>{href ? <a href={href}>{product.data.name}</a> : product.data.name}</h2><p>{product.data.summary.text}</p>{href && <a href={href} aria-label={`Read our ${product.data.name} research`}>Read research <span aria-hidden="true">→</span></a>}</article>
<style>.product-card h2 { font-size: 1.45rem; } .product-card h2 a { color: var(--ink); text-decoration: none; }</style>
