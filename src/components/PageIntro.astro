---
interface Props { eyebrow?: string; title: string; description: string }
const { eyebrow, title, description } = Astro.props;
---
<header class="page-intro"><div class="container">{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1><p class="lede">{description}</p></div></header>
<style>.page-intro { padding-block: clamp(3rem, 8vw, 6rem); border-bottom: 1px solid var(--line); background: linear-gradient(140deg, var(--surface-muted), var(--paper)); } .page-intro h1 { font-size: clamp(2.2rem, 6vw, 4rem); max-width: 54rem; }</style>
