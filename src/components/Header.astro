---
const nav = [
  { href: '/software/', label: 'Software' },
  { href: '/software/#categories', label: 'Categories' },
  { href: '/software/#reviews', label: 'Reviews' },
  { href: '/software/#comparisons', label: 'Comparisons' },
  { href: '/how-we-review/', label: 'Methodology' },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="SelectVerdict home"><span aria-hidden="true">SV</span> SelectVerdict</a>
    <nav aria-label="Primary navigation">
      <ul>
        {nav.map((item) => <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 94%, transparent); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4.5rem; }
  .brand { color: var(--ink); font-weight: 850; text-decoration: none; white-space: nowrap; }
  .brand span { display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin-right: 0.4rem; border-radius: 50%; background: var(--brand); color: white; font-size: 0.72rem; letter-spacing: 0.05em; }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  nav a { color: var(--ink-soft); font-size: 0.92rem; font-weight: 650; text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--brand); }
  @media (max-width: 48rem) { .header-inner { align-items: flex-start; flex-direction: column; padding-block: 0.9rem; } ul { gap: 0.45rem 1rem; } }
</style>
