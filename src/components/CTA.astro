---
interface Props { title: string; text: string; href: string; label: string; secondary?: boolean }
const { title, text, href, label, secondary = false } = Astro.props;
---
<aside class="cta" aria-labelledby="cta-title"><div><h2 id="cta-title">{title}</h2><p>{text}</p></div><a class:list={['button', { 'button-secondary': secondary }]} href={href}>{label}</a></aside>
<style>
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius); background: var(--ink); color: white; }
  h2 { font-size: clamp(1.4rem, 3vw, 2rem); margin-bottom: 0.4rem; }
  p { color: #dce5e0; margin: 0; }
  .button-secondary { border-color: white; color: white; }
  @media (max-width: 38rem) { .cta { align-items: flex-start; flex-direction: column; } }
</style>
