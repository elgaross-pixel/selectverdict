---
interface Props {
  href: string;
  hasRelationship: boolean;
  label: string;
  class?: string;
  merchant?: string;
  product?: string;
  sourcePage?: string;
}

import MerchantLink from './MerchantLink.astro';
const { href, hasRelationship, label, class: className, merchant = 'unknown', product = 'unknown', sourcePage = '/' } = Astro.props;
if (!hasRelationship) {
  throw new Error('Affiliate links may only render for an explicitly declared affiliate relationship.');
}
---

<MerchantLink href={href} merchant={merchant} product={product} sourcePage={sourcePage} affiliate={true} label={label} class={className} />
