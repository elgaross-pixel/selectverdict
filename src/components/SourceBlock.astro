---
interface Source { title: string; url: string; publisher?: string; accessedAt: Date; supports: string }
interface Props { sources: Source[] }
const { sources } = Astro.props;
---
<section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">Sources and verification</h2>{sources.length > 0 ? <ol>{sources.map((source) => <li><a href={source.url} rel="nofollow noopener">{source.title}</a>{source.publisher && ` — ${source.publisher}`}<br /><span>{source.supports} Accessed {source.accessedAt.toISOString().slice(0, 10)}.</span></li>)}</ol> : <p>No factual sources have been published for this page.</p>}</section>
<style>.sources { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); } li + li { margin-top: 1rem; } span { color: var(--ink-soft); font-size: 0.9rem; }</style>
