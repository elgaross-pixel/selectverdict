---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import SourceBlock from '../../components/SourceBlock.astro'; import VerdictBlock from '../../components/VerdictBlock.astro'; import { formatDate, getValidatedContent, type AlternativeGuide, type Product } from '../../lib/content';
export async function getStaticPaths() { return (await getValidatedContent()).alternatives.map(({ guide, product, alternatives }) => ({ params: { product: guide.data.slug }, props: { guide, product, alternatives } })); }
interface Props { guide: AlternativeGuide; product: Product; alternatives: Product[] } const { guide, alternatives } = Astro.props;
---
<BaseLayout title={guide.data.title} description={guide.data.description}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: guide.data.title }]} /><section class="section"><div class="container"><p class="eyebrow">Alternative software</p><h1>{guide.data.title}</h1><p class="lede">{guide.data.description}</p><p class="meta">Last verified: <time datetime={guide.data.lastVerified!.toISOString()}>{formatDate(guide.data.lastVerified!)}</time></p><div class="grid grid-3 product-grid">{alternatives.map((alternative) => <ProductCard product={alternative} />)}</div><div class="narrow detail"><VerdictBlock summary={guide.data.conclusion!.summary} basis={guide.data.conclusion!.basis} /><p><strong>Methodology:</strong> {guide.data.methodology}</p><SourceBlock sources={guide.data.sources} /></div></div></section></BaseLayout>
<style>.product-grid { margin-top: 2rem; }</style>
