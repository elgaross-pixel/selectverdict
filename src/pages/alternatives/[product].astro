---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import { getPublishedProducts, type Product } from '../../lib/content';
export async function getStaticPaths() { const products = await getPublishedProducts(); return products.map((product) => ({ params: { product: product.data.slug }, props: { product, alternatives: products.filter((candidate) => product.data.alternatives.includes(candidate.data.slug)) } })); }
interface Props { product: Product; alternatives: Product[] } const { product, alternatives } = Astro.props;
---
<BaseLayout title={`${product.data.name} alternatives`} description={`Research-backed alternatives to ${product.data.name}, with fit and tradeoffs made clear.`}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: `${product.data.name} review`, href: `/reviews/${product.data.slug}/` }, { label: 'Alternatives' }]} /><section class="section"><div class="container"><p class="eyebrow">Alternative software</p><h1>{product.data.name} alternatives</h1><p class="lede">Consider these products when their documented fit better matches your requirements. Inclusion is not a claim that every option is universally superior.</p>{alternatives.length ? <div class="grid grid-3 product-grid">{alternatives.map((alternative) => <ProductCard product={alternative} />)}</div> : <div class="empty-state"><h2>No alternatives are published yet</h2><p>We have not completed enough related product research to make a responsible list.</p></div>}</div></section></BaseLayout>
<style>.product-grid { margin-top: 2rem; }</style>
