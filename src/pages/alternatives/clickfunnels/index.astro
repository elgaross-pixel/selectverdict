  { title: 'Pricing and Service Plans', url: 'https://www.getresponse.com/pricing', publisher: 'GetResponse', accessedAt: new Date('2026-09-10'), supports: 'Starter, Marketer and Creator pricing and included email, automation, funnel and course capabilities.' },
  { title: 'How does GetResponse pricing work?', url: 'https://www.getresponse.com/help/how-does-getresponse-pricing-work.html', publisher: 'GetResponse', accessedAt: new Date('2026-09-10'), supports: 'List-size tiers and pay-as-you-grow pricing model.' },
