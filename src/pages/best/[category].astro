---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import SourceBlock from '../../components/SourceBlock.astro'; import VerdictBlock from '../../components/VerdictBlock.astro'; import { categoryLabel, formatDate, getValidatedContent, type Product, type Recommendation } from '../../lib/content';
export async function getStaticPaths() { return (await getValidatedContent()).recommendations.map(({ recommendation, products }) => ({ params: { category: recommendation.data.category }, props: { recommendation, products } })); }
interface Props { recommendation: Recommendation; products: Product[] } const { recommendation, products } = Astro.props; const { data } = recommendation; const name = categoryLabel(data.category);
---
<BaseLayout title={data.title} description={data.description}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: name, href: `/categories/${data.category}/` }, { label: data.title }]} /><section class="section"><div class="container"><p class="eyebrow">Category recommendations</p><h1>{data.title}</h1><p class="lede">{data.description}</p><p class="meta">Last verified: <time datetime={data.lastVerified!.toISOString()}>{formatDate(data.lastVerified!)}</time></p><div class="grid grid-3 product-grid">{products.map((product) => <ProductCard product={product} />)}</div><div class="narrow detail"><VerdictBlock summary={data.conclusion!.summary} basis={data.conclusion!.basis} /><p><strong>Methodology:</strong> {data.methodology}</p><SourceBlock sources={data.sources} /></div></div></section></BaseLayout>
<style>.product-grid { margin-block: 2rem; }</style>
