---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import { categoryLabel, getCategories, getPublishedProducts, type Product } from '../../lib/content';
export async function getStaticPaths() { const products = await getPublishedProducts(); return getCategories(products).map(({ slug }) => ({ params: { category: slug }, props: { products: products.filter(({ data }) => data.categories.includes(slug)), slug } })); }
interface Props { products: Product[]; slug: string } const { products, slug } = Astro.props; const name = categoryLabel(slug);
---
<BaseLayout title={`Best ${name} software`} description={`Evidence-based SelectVerdict recommendations for ${name.toLowerCase()} software, organized by buyer fit.`}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: name, href: `/categories/${slug}/` }, { label: 'Recommendations' }]} /><section class="section"><div class="container"><p class="eyebrow">Category recommendations</p><h1>Best {name} software</h1><p class="lede">“Best” depends on your requirements. We organize researched products by fit and tradeoffs instead of declaring a context-free winner.</p><div class="grid grid-3 product-grid">{products.map((product) => <ProductCard product={product} />)}</div><p class="meta">Recommendations are editorial assessments. Review each product's sources and last-verified date before deciding.</p></div></section></BaseLayout>
<style>.product-grid { margin-block: 2rem; }</style>
