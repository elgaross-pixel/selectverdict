---
import { getCollection, type CollectionEntry } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import SourceBlock from '../../components/SourceBlock.astro'; import VerdictBlock from '../../components/VerdictBlock.astro'; import ProductCard from '../../components/ProductCard.astro'; import { getPublishedProducts, formatDate, type Product } from '../../lib/content';
type Comparison = CollectionEntry<'comparisons'>;
export async function getStaticPaths() { const comparisons = await getCollection('comparisons', ({ data }) => data.status === 'published'); const products = await getPublishedProducts(); return comparisons.map((comparison) => ({ params: { slug: comparison.data.slug }, props: { comparison, products: comparison.data.products.map((slug) => products.find((item) => item.data.slug === slug)).filter(Boolean) } })); }
interface Props { comparison: Comparison; products: Product[] } const { comparison, products } = Astro.props; const { data } = comparison;
---
<BaseLayout title={data.title} description={data.description}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: data.title }]} /><section class="section"><div class="container"><p class="eyebrow">Software comparison</p><h1>{data.title}</h1><p class="lede">{data.description}</p>{data.lastVerified && <p class="meta">Last verified: <time datetime={data.lastVerified.toISOString()}>{formatDate(data.lastVerified)}</time></p>}<div class="grid product-grid">{products.map((product) => <ProductCard product={product} />)}</div><div class="narrow detail">{data.conclusion && <VerdictBlock summary={data.conclusion.summary} basis={data.conclusion.basis} />}<SourceBlock sources={data.sources} /></div></div></section></BaseLayout>
<style>.product-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); margin-block: 2.5rem; } .detail > :global(*) + :global(*) { margin-top: 2rem; }</style>
