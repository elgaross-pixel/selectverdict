---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categoryLabel, getCategories, getValidatedContent, type Product } from '../../lib/content';
import { getCategoryEditorial } from '../../data/categoryEditorial';

export async function getStaticPaths() {
  const content = await getValidatedContent();
  const reviewSlugs = new Set(content.reviews.map(({ product }) => product.data.slug));
  const visibleProducts = content.products.filter((product) =>
    reviewSlugs.has(product.data.slug) || content.recommendations.some(({ recommendation }) =>
      recommendation.data.category && product.data.categories.includes(recommendation.data.category)));
  const recommendationSlugs = new Set(content.recommendations.map(({ recommendation }) => recommendation.data.category));
  return getCategories(visibleProducts).map(({ slug }) => ({
    params: { category: slug },
    props: {
      products: visibleProducts.filter(({ data }) => data.categories.includes(slug)),
      reviewSlugs: [...reviewSlugs],
      slug,
      hasRecommendation: recommendationSlugs.has(slug),
    },
  }));
}

interface Props { products: Product[]; reviewSlugs: string[]; slug: string; hasRecommendation: boolean }
const { products, reviewSlugs, slug, hasRecommendation } = Astro.props;
const name = categoryLabel(slug);
const editorial = getCategoryEditorial(slug, name);
const evidence = editorial.evidence;
const showEvidence = evidence && products.some(({ data }) => data.slug === evidence.productSlug);
---
<BaseLayout title={editorial.seoTitle} description={editorial.metaDescription}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: name }]} />
  <article class="section">
    <div class="container">
      <header class="reading-width">
        <p class="eyebrow">{editorial.eyebrow}</p>
        <h1>{editorial.h1}</h1>
        <p class="lede">{editorial.lede}</p>
        {editorial.intro.map((paragraph) => <p>{paragraph}</p>)}
        {editorial.examples && <ul>{editorial.examples.map((example) => <li>{example}</li>)}</ul>}
        {editorial.introClosing?.map((paragraph) => <p>{paragraph}</p>)}
      </header>
      {editorial.criteria.length > 0 && <section class="hub-section" aria-labelledby="evaluation-title">
        <h2 id="evaluation-title">What we evaluate</h2>
        <div class="grid criteria-grid">
          {editorial.criteria.map((criterion) => <section class="card">
            <h3>{criterion.heading}</h3>
            {criterion.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>)}
        </div>
      </section>}
      <section class="hub-section" aria-labelledby="software-title">
        <h2 id="software-title">Software we have researched</h2>
        <div class="grid grid-3 product-grid">
          {products.map((product) => <ProductCard product={product} href={reviewSlugs.includes(product.data.slug) ? `/reviews/${product.data.slug}/` : undefined} />)}
        </div>
        {showEvidence && <aside class="card evidence reading-width" aria-labelledby="evidence-title">
          <h3 id="evidence-title">{evidence.heading}</h3>
          {evidence.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {evidence.steps && <ul>{evidence.steps.map((step) => <li>{step}</li>)}</ul>}
          <p><strong>Evidence boundary:</strong> {evidence.boundary}</p>
        </aside>}
      </section>
      {editorial.relatedResearch.length > 0 && <section class="hub-section reading-width" aria-labelledby="research-title">
        <h2 id="research-title">Related research</h2>
        <ul class="research-links">{editorial.relatedResearch.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </section>}
      {editorial.closing.length > 0 && <section class="hub-section reading-width" aria-labelledby="choose-title">
        <h2 id="choose-title">How to choose</h2>
        {editorial.closing.map((paragraph) => <p>{paragraph}</p>)}
      </section>}
      {hasRecommendation && <p class="recommendation-link"><a href={`/best/${slug}/`}>See our {name.toLowerCase()} recommendations →</a></p>}
    </div>
  </article>
</BaseLayout>
<style>
  .reading-width { max-width: var(--measure); }
  .hub-section { margin-top: 3rem; }
  .criteria-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .criteria-grid h3, .evidence h3 { margin-top: 0; }
  .product-grid { margin-block: 1.5rem; }
  .evidence { background: var(--surface-muted); }
  .research-links li + li { margin-top: 0.65rem; }
  .recommendation-link { margin-top: 2rem; }
  @media (max-width: 42rem) { .criteria-grid { grid-template-columns: 1fr; } }
</style>
