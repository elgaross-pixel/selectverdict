---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import { categoryLabel, getCategories, getValidatedContent, type Product } from '../../lib/content';
export async function getStaticPaths() { const content = await getValidatedContent(); const reviewSlugs = new Set(content.reviews.map(({ product }) => product.data.slug)); const visibleProducts = content.products.filter((product) => reviewSlugs.has(product.data.slug) || content.recommendations.some(({ recommendation }) => recommendation.data.category && product.data.categories.includes(recommendation.data.category))); const recommendationSlugs = new Set(content.recommendations.map(({ recommendation }) => recommendation.data.category)); return getCategories(visibleProducts).map(({ slug }) => ({ params: { category: slug }, props: { products: visibleProducts.filter(({ data }) => data.categories.includes(slug)), reviewSlugs: [...reviewSlugs], slug, hasRecommendation: recommendationSlugs.has(slug) } })); }
interface Props { products: Product[]; reviewSlugs: string[]; slug: string; hasRecommendation: boolean } const { products, reviewSlugs, slug, hasRecommendation } = Astro.props; const name = categoryLabel(slug);
---
<BaseLayout title={`${name} software research`} description={`Independent research and reviews for ${name.toLowerCase()} software.`}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: name }]} /><section class="section"><div class="container"><p class="eyebrow">Software category</p><h1>{name}</h1><p class="lede">Published, source-backed research for this category.</p><div class="grid grid-3 product-grid">{products.map((product) => <ProductCard product={product} href={reviewSlugs.includes(product.data.slug) ? `/reviews/${product.data.slug}/` : undefined} />)}</div>{hasRecommendation && <p><a href={`/best/${slug}/`}>See our {name.toLowerCase()} recommendations →</a></p>}</div></section></BaseLayout>
<style>.product-grid { margin-block: 2rem; }</style>
