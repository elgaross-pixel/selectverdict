---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCategories, getValidatedContent } from '../../lib/content';
const { reviews, comparisons } = await getValidatedContent();
const products = reviews.map(({ product }) => product);
const categories = getCategories(products);
---
<BaseLayout title="Software research library" description="Browse SelectVerdict's independently researched software reviews, comparisons, alternatives, and category recommendations.">
  <PageIntro eyebrow="Research library" title="Software decisions, organized around evidence." description="Browse published research by product or category. We only list commercial pages after their sources and verification details are ready." />
  <section class="section"><div class="container"><section id="categories"><h2>Categories</h2>{categories.length ? <ul class="category-list">{categories.map((category) => <li><a href={`/categories/${category.slug}/`}>{category.name}</a></li>)}</ul> : <div class="empty-state"><h3>Category research is being prepared</h3><p>No researched categories are published yet. We will add them as evidence-backed product records clear editorial review.</p></div>}</section>
  <section id="reviews" class="library-section"><h2>Reviews</h2>{products.length ? <div class="grid grid-3">{products.map((product) => <ProductCard product={product} href={`/reviews/${product.data.slug}/`} />)}</div> : <div class="empty-state"><h3>No product reviews are published yet</h3><p>That is intentional: SelectVerdict will not fill the library with invented facts, ratings, or testing claims.</p></div>}</section>
  <section id="comparisons" class="library-section"><h2>Comparisons</h2>{comparisons.length ? <ul>{comparisons.map(({ comparison }) => <li><a href={`/compare/${comparison.data.slug}/`}>{comparison.data.title}</a></li>)}</ul> : <div class="empty-state"><h3>Comparisons will follow completed product research</h3><p>Comparison pages require verified records for every included product. None are ready for publication yet.</p></div>}</section></div></section>
</BaseLayout>
<style>.library-section { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--line); } .category-list { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0; list-style: none; } .category-list a { display: block; padding: 0.65rem 0.9rem; border: 1px solid var(--line); border-radius: 2rem; background: white; text-decoration: none; }</style>
