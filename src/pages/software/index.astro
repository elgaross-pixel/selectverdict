---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductCard from '../../components/ProductCard.astro';
import editorialLibrary from '../../data/editorial-library.json';
import { getCategories, getValidatedContent } from '../../lib/content';

const { reviews } = await getValidatedContent();
const products = reviews.map(({ product }) => product);
const categories = getCategories(products);
const sections = ['Pricing','Guides','Alternatives','Comparisons','Best'];
const byType = Object.fromEntries(sections.map((type) => [type, editorialLibrary.filter((item) => item.type === type)]));
---
<BaseLayout title="Software research library" description="Browse SelectVerdict's independently researched software reviews, pricing guides, tutorials, alternatives, comparisons, and category recommendations.">
  <PageIntro eyebrow="Research library" title="Software decisions, organized around evidence." description="Browse published research by product, decision type, or category. Commercial pages appear here after their sources and verification details are ready." />
  <section class="section"><div class="container">
    <section id="categories"><h2>Categories</h2>{categories.length ? <ul class="category-list">{categories.map((category) => <li><a href={`/categories/${category.slug}/`}>{category.name}</a></li>)}</ul> : <div class="empty-state"><h3>Category research is being prepared</h3><p>No researched categories are published yet.</p></div>}</section>
    <section id="reviews" class="library-section"><h2>Reviews</h2>{products.length ? <div class="grid grid-3">{products.map((product) => <ProductCard product={product} href={`/reviews/${product.data.slug}/`} />)}</div> : <div class="empty-state"><h3>No product reviews are published yet</h3></div>}</section>
    {sections.map((type) => <section id={type.toLowerCase()} class="library-section"><h2>{type}</h2>{byType[type].length ? <div class="research-list">{byType[type].map((item) => <article><h3><a href={item.href}>{item.title}</a></h3>{item.description && <p>{item.description}</p>}</article>)}</div> : <div class="empty-state"><h3>No {type.toLowerCase()} are published yet</h3></div>}</section>)}
  </div></section>
</BaseLayout>
<style>
.library-section{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--line)}.category-list{display:flex;flex-wrap:wrap;gap:.75rem;padding:0;list-style:none}.category-list a{display:block;padding:.65rem .9rem;border:1px solid var(--line);border-radius:2rem;background:white;text-decoration:none}.research-list{display:grid;gap:1rem}.research-list article{padding:1.2rem 1.3rem;border:1px solid var(--line);border-radius:.85rem;background:white}.research-list h3{margin:0;font-size:1.08rem}.research-list h3 a{color:var(--ink)}.research-list p{margin:.5rem 0 0;color:var(--ink-soft)}
</style>
