---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro'; import SourceBlock from '../../components/SourceBlock.astro'; import VerdictBlock from '../../components/VerdictBlock.astro';
import { getValidatedContent, formatDate, categoryLabel, type Product, type Review } from '../../lib/content';
export async function getStaticPaths() { return (await getValidatedContent()).reviews.map(({ review, product }) => ({ params: { product: product.data.slug }, props: { review, product } })); }
interface Props { review: Review; product: Product } const { review, product } = Astro.props; const { data } = product; const editorial = review.data;
---
<BaseLayout title={editorial.title} description={editorial.description}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: editorial.title }]} /><article><header class="section"><div class="container"><p class="eyebrow">Software review</p><h1>{editorial.title}</h1><p class="lede">{editorial.description}</p><p class="meta">Editorial research last verified: <time datetime={editorial.lastVerified!.toISOString()}>{formatDate(editorial.lastVerified!)}</time></p></div></header><div class="narrow prose review-body"><AffiliateDisclosure hasRelationship={data.hasAffiliateRelationship} /><VerdictBlock summary={editorial.conclusion!.summary} basis={editorial.conclusion!.basis} /><h2>Product facts</h2><dl><dt>Categories</dt><dd>{data.categories.map(categoryLabel).join(', ')}</dd>{data.pricingSummary && data.pricingSummary.status !== 'unverified' && <><dt>Pricing</dt><dd>{data.pricingSummary.text} <small>({data.pricingSummary.status})</small></dd></>}{data.officialWebsite && <><dt>Official website</dt><dd><a href={data.officialWebsite} rel="nofollow noopener">Visit official site</a></dd></>}</dl><h2>Who it may suit</h2><ul>{data.bestFor.filter((item) => item.status !== 'unverified').map((item) => <li>{item.text} <small>({item.status})</small></li>)}</ul><h2>Who should look elsewhere</h2><ul>{data.notFor.filter((item) => item.status !== 'unverified').map((item) => <li>{item.text} <small>({item.status})</small></li>)}</ul><div class="two-col"><section><h2>Pros</h2><ul>{data.pros.filter((item) => item.status !== 'unverified').map((item) => <li>{item.text}</li>)}</ul></section><section><h2>Cons</h2><ul>{data.cons.filter((item) => item.status !== 'unverified').map((item) => <li>{item.text}</li>)}</ul></section></div><p><strong>Methodology:</strong> {editorial.methodology}</p><SourceBlock sources={editorial.sources} /></div></article></BaseLayout>
<style>.review-body { padding-block: 3rem 5rem; } .review-body > :global(*) + :global(*) { margin-top: 2rem; } dt { font-weight: 800; } dd { margin: 0 0 1rem; } .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; } @media (max-width: 38rem) { .two-col { grid-template-columns: 1fr; } }</style>
