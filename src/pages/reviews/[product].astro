---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro'; import SourceBlock from '../../components/SourceBlock.astro'; import VerdictBlock from '../../components/VerdictBlock.astro';
import { getPublishedProducts, formatDate, categoryLabel, type Product } from '../../lib/content';
export async function getStaticPaths() { return (await getPublishedProducts()).map((product) => ({ params: { product: product.data.slug }, props: { product } })); }
interface Props { product: Product } const { product } = Astro.props; const { data } = product;
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: `${data.name} review`, description: data.summary.text, dateModified: data.lastVerified?.toISOString(), author: { '@type': 'Organization', name: 'SelectVerdict' }, publisher: { '@type': 'Organization', name: 'SelectVerdict' } };
---
<BaseLayout title={`${data.name} review`} description={data.summary.text} schema={schema}><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Software', href: '/software/' }, { label: `${data.name} review` }]} /><article><header class="section"><div class="container"><p class="eyebrow">Software review</p><h1>{data.name}</h1><p class="lede">{data.summary.text}</p>{data.lastVerified && <p class="meta">Last verified: <time datetime={data.lastVerified.toISOString()}>{formatDate(data.lastVerified)}</time></p>}</div></header><div class="narrow prose review-body"><AffiliateDisclosure hasRelationship={data.hasAffiliateRelationship} />{data.verdict && <VerdictBlock summary={data.verdict.summary} basis={data.verdict.basis} />}<h2>Product facts</h2><dl><dt>Categories</dt><dd>{data.categories.map(categoryLabel).join(', ')}</dd>{data.pricingSummary && <><dt>Pricing</dt><dd>{data.pricingSummary.text} <small>({data.pricingSummary.status})</small></dd></>}{data.officialWebsite && <><dt>Official website</dt><dd><a href={data.officialWebsite} rel="nofollow noopener">Visit official site</a></dd></>}</dl><h2>Who it may suit</h2><ul>{data.bestFor.map((item) => <li>{item.text} <small>({item.status})</small></li>)}</ul><h2>Who should look elsewhere</h2><ul>{data.notFor.map((item) => <li>{item.text} <small>({item.status})</small></li>)}</ul><div class="two-col"><section><h2>Pros</h2><ul>{data.pros.map((item) => <li>{item.text}</li>)}</ul></section><section><h2>Cons</h2><ul>{data.cons.map((item) => <li>{item.text}</li>)}</ul></section></div><SourceBlock sources={data.sources} /></div></article></BaseLayout>
<style>.review-body { padding-block: 3rem 5rem; } .review-body > :global(*) + :global(*) { margin-top: 2rem; } dt { font-weight: 800; } dd { margin: 0 0 1rem; } .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; } @media (max-width: 38rem) { .two-col { grid-template-columns: 1fr; } }</style>
